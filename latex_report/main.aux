\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {IV-D}}Label Assignment and Dataset Balance}{3}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Raw 8-channel sEMG signals recorded during the aggressive action ``Punching'' (Subject 1). Sharp, high-amplitude bursts are evident in the arm muscle channels (CH1--CH4).}}{3}{}\protected@file@percent }
\newlabel{fig:raw_punching}{{3}{3}{}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Comparison of 64-dimensional feature profiles between Bowing (Normal) and Punching (Aggressive). Distinct peaks clearly distinguish arm-driven strikes from leg-supported trunk bending.}}{3}{}\protected@file@percent }
\newlabel{fig:feature_profiles}{{4}{3}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Dataset balance check. Left: Exactly 60 trials per multiclass action. Right: Exactly 600 Normal trials vs. 600 Aggressive trials.}}{4}{}\protected@file@percent }
