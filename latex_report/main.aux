\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Block diagram of the proposed surface EMG physical action classification approach, showing raw data acquisition, trial slicing, temporal feature extraction, leakage-free standardization, and classification into binary and multiclass case studies.}}{3}{}\protected@file@percent }
