\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Raw 8-channel sEMG signals recorded during the normal action ``Bowing'' (Subject 1). Notice the smooth, steady electrical activity primarily concentrated on the leg channels (CH5--CH8).}}{3}{}\protected@file@percent }
